APP_ENV=production

# Allowed Frontend Origins (comma-separated for multiple origins)
# e.g. https://yourdomain.com,https://www.yourdomain.com,http://localhost:5173
FRONTEND_URL=https://yourdomain.com,https://www.yourdomain.com

# Gmail SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=yourbusiness@gmail.com
SMTP_PASS=your_16_digit_app_password

# Sender Name displayed in emails
SMTP_FROM_NAME="William Cleaning Services"

# Administrator Email (recipient of customer inquiries)
RECEIVER_EMAIL=info.willamscleaning@gmail.com
